  {"op":"add-textbox","slide":"p","text":"MODERN WEALTH PLAYBOOK","x":40,"y":35,"width":200,"height":24,"font_size":11,"bold":true,"color":"#10B981","font_family":"Montserrat"},
  {"op":"add-textbox","slide":"p","text":"Stocks & Shares:\nBeyond The Noise.","x":40,"y":95,"width":640,"height":110,"font_size":40,"bold":true,"color":"#FFFFFF","font_family":"Montserrat"},
  {"op":"add-textbox","slide":"p","text":"How to transition from being an everyday consumer into a legal co-owner of the world's most profitable businesses.","x":40,"y":220,"width":620,"height":55,"font_size":16,"color":"#94A3B8","font_family":"Roboto","line_spacing":140},
  {"op":"add-shape","slide":"p","shape_type":"RECTANGLE","x":40,"y":295,"width":80,"height":4,"background_color":"#10B981"},
  {"op":"add-textbox","slide":"p","text":"STRUCTURED GUIDE  •  PLAIN ENGLISH  •  ACTIONABLE FRAMEWORK","x":40,"y":320,"width":600,"height":30,"font_size":12,"bold":true,"color":"#38BDF8","font_family":"Roboto"},
  {"op":"set-notes","slide":"p","text":"Intro slide. Hook the audience: Transitioning from being a consumer to an owner."},

  {"op":"add-slide","layout":"BLANK","id":"SLIDE_1"},
  {"op":"set-background","slide":"SLIDE_1","color":"#0B0F19"},
  {"op":"add-textbox","slide":"SLIDE_1","text":"MINDSET SHIFT","x":40,"y":20,"width":640,"height":25,"font_size":11,"bold":true,"color":"#38BDF8","font_family":"Montserrat"},
  {"op":"add-textbox","slide":"SLIDE_1","text":"Consumer vs. Owner: Flipping The Script","x":40,"y":45,"width":640,"height":40,"font_size":28,"bold":true,"color":"#FFFFFF","font_family":"Montserrat"},
  {"op":"add-shape","slide":"SLIDE_1","shape_type":"ROUND_RECTANGLE","x":40,"y":100,"width":305,"height":220,"background_color":"#161E31"},
  {"op":"add-textbox","slide":"SLIDE_1","text":"The Consumer Cycle","x":60,"y":115,"width":265,"height":30,"font_size":18,"bold":true,"color":"#F87171","font_family":"Montserrat"},
  {"op":"add-textbox","slide":"SLIDE_1","text":"• Spends $1,200 annually on device upgrades\n• Pays ongoing monthly platform subscriptions\n• Money flows outward to strengthen corporations\n• Result: 0% financial equity and depreciating assets","x":60,"y":150,"width":265,"height":150,"font_size":13,"color":"#94A3B8","font_family":"Roboto","line_spacing":135},
  {"op":"add-shape","slide":"SLIDE_1","shape_type":"ROUND_RECTANGLE","x":375,"y":100,"width":305,"height":220,"background_color":"#161E31"},
  {"op":"add-textbox","slide":"SLIDE_1","text":"The Shareholder Advantage","x":395,"y":115,"width":265,"height":30,"font_size":18,"bold":true,"color":"#10B981","font_family":"Montserrat"},
  {"op":"add-textbox","slide":"SLIDE_1","text":"• Allocates into the companies used daily\n• When sales rise, corporate earnings expand\n• Share price appreciates and dividends payout\n• Result: Building compounding equity as a co-owner","x":395,"y":150,"width":265,"height":150,"font_size":13,"color":"#94A3B8","font_family":"Roboto","line_spacing":135},
  {"op":"add-textbox","slide":"SLIDE_1","text":"Principle: You don't need to build a tech empire from scratch. You can just own a slice.","x":40,"y":340,"width":640,"height":30,"font_size":13,"bold":true,"color":"#FBBF24","font_family":"Roboto","alignment":"center"},
  {"op":"set-notes","slide":"SLIDE_1","text":"Contrast consumer spending with asset accumulation."},

  {"op":"add-slide","layout":"BLANK","id":"SLIDE_2"},
  {"op":"set-background","slide":"SLIDE_2","color":"#0B0F19"},
  {"op":"add-textbox","slide":"SLIDE_2","text":"CORE MECHANICS","x":40,"y":20,"width":640,"height":25,"font_size":11,"bold":true,"color":"#A855F7","font_family":"Montserrat"},
  {"op":"add-textbox","slide":"SLIDE_2","text":"Demystifying The Share: How Equity Works","x":40,"y":45,"width":640,"height":40,"font_size":28,"bold":true,"color":"#FFFFFF","font_family":"Montserrat"},
  {"op":"add-shape","slide":"SLIDE_2","shape_type":"ROUND_RECTANGLE","x":40,"y":100,"width":200,"height":220,"background_color":"#161E31"},
  {"op":"add-textbox","slide":"SLIDE_2","text":"01","x":55,"y":115,"width":170,"height":35,"font_size":28,"bold":true,"color":"#38BDF8","font_family":"Montserrat"},
  {"op":"add-textbox","slide":"SLIDE_2","text":"TOTAL VALUATION\nA public enterprise is appraised at an aggregate dollar valuation (e.g. $2 Trillion across global operations).","x":55,"y":155,"width":170,"height":140,"font_size":12,"color":"#94A3B8","font_family":"Roboto","line_spacing":125},
  {"op":"add-shape","slide":"SLIDE_2","shape_type":"ROUND_RECTANGLE","x":260,"y":100,"width":200,"height":220,"background_color":"#161E31"},
  {"op":"add-textbox","slide":"SLIDE_2","text":"02","x":275,"y":115,"width":170,"height":35,"font_size":28,"bold":true,"color":"#10B981","font_family":"Montserrat"},
  {"op":"add-textbox","slide":"SLIDE_2","text":"EQUITY DIVISION\nBecause individuals lack billions in capital, corporate equity is divided into millions of identical units called shares.","x":275,"y":155,"width":170,"height":140,"font_size":12,"color":"#94A3B8","font_family":"Roboto","line_spacing":125},
  {"op":"add-shape","slide":"SLIDE_2","shape_type":"ROUND_RECTANGLE","x":480,"y":100,"width":200,"height":220,"background_color":"#161E31"},
  {"op":"add-textbox","slide":"SLIDE_2","text":"03","x":495,"y":115,"width":170,"height":35,"font_size":28,"bold":true,"color":"#A855F7","font_family":"Montserrat"},
  {"op":"add-textbox","slide":"SLIDE_2","text":"LEGAL OWNERSHIP\nHolding a share gives certified legal property rights to a proportionate fraction of net assets and revenue.","x":495,"y":155,"width":170,"height":140,"font_size":12,"color":"#94A3B8","font_family":"Roboto","line_spacing":125},
  {"op":"add-textbox","slide":"SLIDE_2","text":"A share is not a lottery ticket. It is certified property ownership in an operating business.","x":40,"y":340,"width":640,"height":30,"font_size":13,"bold":true,"color":"#38BDF8","font_family":"Roboto","alignment":"center"},
  {"op":"set-notes","slide":"SLIDE_2","text":"Explain how equity division creates accessibility for everyday investors."},

  {"op":"add-slide","layout":"BLANK","id":"SLIDE_3"},
  {"op":"set-background","slide":"SLIDE_3","color":"#0B0F19"},
  {"op":"add-textbox","slide":"SLIDE_3","text":"TERMINOLOGY","x":40,"y":20,"width":640,"height":25,"font_size":11,"bold":true,"color":"#38BDF8","font_family":"Montserrat"},
  {"op":"add-textbox","slide":"SLIDE_3","text":"Three Core Terms You Need To Master","x":40,"y":45,"width":640,"height":40,"font_size":28,"bold":true,"color":"#FFFFFF","font_family":"Montserrat"},
  {"op":"add-shape","slide":"SLIDE_3","shape_type":"ROUND_RECTANGLE","x":40,"y":100,"width":200,"height":220,"background_color":"#161E31"},
  {"op":"add-textbox","slide":"SLIDE_3","text":"A STOCK\n\nAsset Category\n\nRefers to general ownership certificates in commercial companies.\n\nExample: 'Allocating to the stock market.'","x":55,"y":115,"width":170,"height":190,"font_size":12,"color":"#94A3B8","font_family":"Roboto","line_spacing":130},
  {"op":"add-shape","slide":"SLIDE_3","shape_type":"ROUND_RECTANGLE","x":260,"y":100,"width":200,"height":220,"background_color":"#161E31"},
  {"op":"add-textbox","slide":"SLIDE_3","text":"A SHARE\n\nQuantifiable Unit\n\nThe exact countable unit in a specific distinct enterprise.\n\nExample: 'Bought 4 shares of Microsoft.'","x":275,"y":115,"width":170,"height":190,"font_size":12,"color":"#94A3B8","font_family":"Roboto","line_spacing":130},
  {"op":"add-shape","slide":"SLIDE_3","shape_type":"ROUND_RECTANGLE","x":480,"y":100,"width":200,"height":220,"background_color":"#161E31"},
  {"op":"add-textbox","slide":"SLIDE_3","text":"THE MARKET\n\nCentral Exchange\n\nThe clearinghouse (NYSE, NASDAQ) matching buyers & sellers.\n\nExample: 'Market opened up today.'","x":495,"y":115,"width":170,"height":190,"font_size":12,"color":"#94A3B8","font_family":"Roboto","line_spacing":130},
  {"op":"add-textbox","slide":"SLIDE_3","text":"Rule: You buy shares of an individual stock through the stock exchange network.","x":40,"y":340,"width":640,"height":30,"font_size":13,"bold":true,"color":"#FBBF24","font_family":"Roboto","alignment":"center"},
  {"op":"set-notes","slide":"SLIDE_3","text":"Distinguish stock, share, and exchange accurately."}
]
